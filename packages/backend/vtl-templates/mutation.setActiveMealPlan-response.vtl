#if($ctx.error)
  ## Handle condition check failure (UserDetails item didn't exist)
  #if($ctx.error.type == "ConditionalCheckFailedException")
    $util.error("UserDetailsNotFound: Cannot set active plan, user details not found.", "NotFound")
  #else
    $util.error($ctx.error.message, $ctx.error.type)
  #end
#end

## Add userId to the result, as it's required by the GraphQL schema
$util.qr($ctx.result.put("userId", $ctx.identity.sub))
$util.toJson($ctx.result)