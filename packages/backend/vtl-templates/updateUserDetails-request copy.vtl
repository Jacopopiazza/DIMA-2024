## Get the authenticated user's ID (sub) - this is THE user to update
#set($authenticatedUserId = $ctx.identity.sub)

#if(!$authenticatedUserId || $authenticatedUserId == "")
  $util.unauthorized()
#end

## Build key using the *authenticated* user's ID
#set($pk = "USER#" + $authenticatedUserId)
#set($sk = "USER_DETAILS")

#set($logMessagePk = "PK value: " + $pk)
$util.qr($util.log($logMessagePk)) ## CORRECTED: Suppress log output
#set($logMessageSk = "SK value: " + $sk)
$util.qr($util.log($logMessageSk)) ## CORRECTED: Suppress log output

## Process input
#set($input = $ctx.args.input) ## This is UpdateUserDetailsInput, does NOT contain userId
#set($values = {})
#set($expressionNames = {})
#set($expressionUpdates = [])
#set($hasUpdatableUserInput = false) ## Flag to track if any user-provided fields are being updated

## Field validation examples (adapt to your business rules)
#if(!$util.isNull($input.targetCalories) && ($input.targetCalories < 500 || $input.targetCalories > 10000))
  $util.error("Invalid target calories. Value must be between 500 and 10000.", "ValidationException")
#end

#if(!$util.isNull($input.dietaryRestrictions))
  #if($input.dietaryRestrictions.length() > 1000) ## Max length for the entire string
    $util.error("Dietary restrictions text is too long. Maximum 1000 characters allowed.", "ValidationException")
  #end
#end

## Iterate through input fields and add them to the update expression if not null
#foreach($entry in $input.entrySet())
  #set($value = $entry.value)
  #if(!$util.isNull($value))
    ## Check for strings that are empty after trimming.
    #if($value.class.name == 'java.lang.String' && $value.trim() == "")
      ## This field (empty string) will be skipped for the update.
    #else
      #set($hasUpdatableUserInput = true)
      #set($expressionKey = "#key_$entry.key")
      #set($expressionValue = ":val_$entry.key")
      $util.qr($expressionNames.put($expressionKey, $entry.key))
      $util.qr($values.put($expressionValue, $util.dynamodb.toDynamoDB($value)))
      $util.qr($expressionUpdates.add("$expressionKey = $expressionValue"))
    #end
  #end
#end

## If no user-provided fields are being updated (all were null or empty strings), throw an error.
#if(!$hasUpdatableUserInput)
  #if($input.size() > 0)
    ## Input was provided, but all fields were filtered out (e.g., all empty strings)
    ## We will still update 'updatedAt', so if that's the only change, an error might be too strict.
    ## Check if $expressionUpdates will *only* contain updatedAt after this.
    #set($userFieldsInUpdate = false)
    #foreach($updateItem in $expressionUpdates)
        #if(!$updateItem.contains("updatedAt")) ## A simple check
            #set($userFieldsInUpdate = true)
            #break
        #end
    #end
    #if(!$userFieldsInUpdate) ## If after iterating input, only timestamp would be set
         $util.error("No updatable user-provided fields found in the input that meet update criteria.", "ValidationException")
    #end
  #else
    ## Input object itself was empty. 'updatedAt' will be set. This is fine.
  #end
#end


## Add/Update 'updatedAt' timestamp
#set($now = $util.time.nowISO8601())
$util.qr($values.put(":updatedAtVal", $util.dynamodb.toDynamoDB($now)))
$util.qr($expressionNames.put("#updatedAtAttr", "updatedAt"))
$util.qr($expressionUpdates.add("#updatedAtAttr = :updatedAtVal"))

## Construct the update expression (will always include updatedAt if we reached here)
#if($expressionUpdates.isEmpty())
    ## This case should ideally not be reached if 'updatedAt' is always added
    ## and the "No updatable fields" check is handled properly.
    $util.error("No fields to update. Input might have been empty or all fields filtered out.", "ValidationException")
#end
#set($expression = "SET " + $util.list.join(", ", $expressionUpdates))

## Condition to ensure the item exists for the authenticated user
#set($conditionExpression = "attribute_exists(PK) AND attribute_exists(SK)")

#set($logMsgExprNames = "Expression Names: " + $util.toJson($expressionNames))
$util.qr($util.log($logMsgExprNames)) ## CORRECTED: Suppress log output
#set($logMsgExprValues = "Expression Values: " + $util.toJson($values))
$util.qr($util.log($logMsgExprValues)) ## CORRECTED: Suppress log output
#set($logMsgFinalExpr = "Final Expression: " + $expression)
$util.qr($util.log($logMsgFinalExpr)) ## CORRECTED: Suppress log output

{
  "version": "2018-05-29",
  "operation": "UpdateItem",
  "key": {
    "PK": $util.dynamodb.toDynamoDB($pk),
    "SK": $util.dynamodb.toDynamoDB($sk)
  },
  "update": {
    "expression": "$expression",
    "expressionNames": $expressionNames,
    "expressionAttributeValues": $values
  },
  "condition": {
    "expression": "$conditionExpression"
  },
  "returnValues": "ALL_NEW"
}