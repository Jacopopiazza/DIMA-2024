#if($ctx.error)
  $util.error($ctx.error.message, $ctx.error.type)
#end

#if(!$ctx.result)
  $util.error("Update operation failed or item did not meet condition.", "UpdateFailed")
#end

## $ctx.result is the updated item. It should contain the userId (from PK) if your DDB item has it as an attribute.
## If not, add it from the identity, as it's required by UserDetails schema.
#if(!$ctx.result.containsKey("userId"))
    $util.qr($ctx.result.put("userId", $ctx.identity.sub))
#end

$util.toJson($ctx.result)